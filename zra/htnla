    <div class="section">
        <h3>2) Morris.js Chiziqli Diagramma</h3>
        <div id="morris-line-chart" style="height: 250px;"></div>
    </div>

    <!-- 3. CanvasJS aylanali diagramma -->
    <div class="section">
        <h3>3) CanvasJS Aylanali Diagramma</h3>
        <div id="canvasjs-pie-chart" style="height: 300px; width: 100%;"></div>
    </div>

    <!-- 4. Input audio ijro -->
    <div class="section">
        <h3>4) Qo'shiqchi yoki qo'shiq nomi kiritilganda audio ijro</h3>
        <input type="text" id="musicInput" placeholder="Masalan: track1">
        <audio id="audioPlayer" controls style="margin-top:10px; display:block;">
            <source id="audioSource" src="" type="audio/mpeg">
        </audio>
    </div>

    <!-- 5, 6, 7. jQuery animatsiyalar -->
    <div class="section">
        <h3>5, 6, 7) jQuery Rasm Animatsiyalari</h3>
        <button id="btnFadeOut">Sekin yo'q bo'lsin (5)</button>
        <button id="btnFadeIn">Sekin paydo bo'lsin (6)</button>
        <button id="btnToggle">Yo'q / Paydo bo'lsin (7)</button>
        <br><br>
        <img id="target-img" src="https://via.placeholder.com/200" alt="Test Rasm">
    </div>

    <!-- 11. Hisoblagich tugmalari -->
    <div class="section">
        <h3>11) Hisoblagich (Counter)</h3>
        <h2 id="counterVal">0</h2>
        <button id="btnInc">1-tugma (+1)</button>
        <button id="btnDec">2-tugma (-1)</button>
        <button id="btnReset">3-tugma (0 ga qaytarish)</button>
    </div>

    <script>
        $(document.body).ready(function () {

            // 1-topshiriq
            $('#toRight').click(function () {
                $('#leftSelect option:selected').appendTo('#rightSelect');
            });
            $('#toLeft').click(function () {
                $('#rightSelect option:selected').appendTo('#leftSelect');
            });

            // 2-topshiriq: Morris Line Chart
            Morris.Line({
                element: 'morris-line-chart',
                data: [
                    { year: '2021', value: 10 },
                    { year: '2022', value: 20 },
                    { year: '2023', value: 15 },
                    { year: '2024', value: 25 }
                ],
                xkey: 'year',
                ykeys: ['value'],
                labels: ['Qiymat']
            });

            // 3-topshiriq: CanvasJS Pie Chart
            var chart = new CanvasJS.Chart("canvasjs-pie-chart", {
                animationEnabled: true,
                title: { text: "Aylanali Diagramma" },
                data: [{
                    type: "pie",
                    startAngle: 240,
                    dataPoints: [
                        { y: 40, label: "HTML/CSS" },
                        { y: 30, label: "JavaScript" },
                        { y: 20, label: "React" },
                        { y: 10, label: "Boshqalar" }
                    ]
                }]
            });
            chart.render();

            // 4-topshiriq: Musiqa chalish
            $('#musicInput').

            
            on('input', function () {
                var val = $(this).val().trim();
                if (val.length > 2) {
                    // Namuna sifatida har qanday audio fayl havola qilinadi
                    $('#audioSource').attr('src', 'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3');
                    var player = $('#audioPlayer')[0];
                    player.load();
                    player.play();
                }
            });

            // 5-topshiriq: FadeOut
            $('#btnFadeOut').click(function () {
                $('#target-img').fadeOut('slow');
            });

            // 6-topshiriq: FadeIn
            $('#btnFadeIn').click(function () {
                $('#target-img').fadeIn('slow');
            });

            // 7-topshiriq: Toggle
            $('#btnToggle').click(function () {
                $('#target-img').fadeToggle('slow');
            });

            // 11-topshiriq: Hisoblagich
            let count = 0;
            $('#btnInc').click(function () {
                count++;
                $('#counterVal').text(count);
            });
            $('#btnDec').click(function () {
                count--;
                $('#counterVal').text(count);
            });
            $('#btnReset').click(function () {
                count = 0;
                $('#counterVal').text(count);
            });

        });
    </script>
</body>

</html>